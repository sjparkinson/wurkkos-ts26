{
  "sandbox": {
    "excludedCommands": [
      "cargo xtask ping *",
      "cargo xtask peek *",
      "cargo xtask backup *",
      "cargo xtask flash *",
      "cargo xtask restore *"
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable-gems \"$(git rev-parse --show-toplevel)/.claude/hooks/pre-tool-use.rb\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable-gems \"$(git rev-parse --show-toplevel)/.claude/hooks/post-tool-use.rb\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
